# Copy to worker/.env on the lab server and fill in. Never commit .env.

# Same Supabase project as web/ and mobile/ (Project Settings > API Keys).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# vLLM's OpenAI-compatible endpoint (see eval/README.md for how to start it).
VLM_BASE_URL=http://127.0.0.1:8137/v1
VLM_MODEL=Qwen/Qwen3.5-9B
# "openai" calls vLLM; "fake" returns canned answers to test the pipeline without a GPU.
VLM_BACKEND=openai

# Judgements per photo; the majority wins. 3 matches eval/compare_eval.py.
VLM_RUNS=3
VLM_CONCURRENCY=8
VLM_THINKING=false
VLM_TIMEOUT=300
MAX_SIDE=1280

POLL_SECONDS=5
# A return stuck in "running" this long (worker crashed) is picked up again.
STALE_MINUTES=15
MAX_ATTEMPTS=3
