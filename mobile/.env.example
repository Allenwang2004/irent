# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# Same project as web/.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). Server-side only; never expose it to the browser.
SUPABASE_SECRET_KEY=
# Shared password for the demo (everyone given the link enters it once a week).
MOBILE_PASSWORD=
# Random string that signs login cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
