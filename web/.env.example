# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). Server-side only; never expose it to the browser.
SUPABASE_SECRET_KEY=
# Shared back-office password for operations staff.
ADMIN_PASSWORD=
# Random string that signs login cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Phone app that vehicle registration links point to (no trailing slash).
MOBILE_BASE_URL=https://irent-mobile.vercel.app
